# Copy this file to ".env" in the same folder (backend/.env) and fill in
# your own Razorpay TEST MODE keys.
#
# How to get them (free, no real money involved in test mode):
#   1. Sign up at https://razorpay.com  (or log in if you already have an account)
#   2. Make sure the dashboard is switched to "Test Mode" (toggle top-left)
#   3. Go to Settings -> API Keys -> Generate Test Key
#   4. Copy the Key Id and Key Secret shown there into the values below
#
# Test mode uses fake card numbers (Razorpay's docs list them) so you can
# run through the full payment flow without spending real money.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx